# ─────────────────────────────────────────────────────────────────────────────
# LOLLMS CLIENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# This file demonstrates the Universal Lazy Profile System.
# Copy this file to ~/.lollms-client/.env or your project's root .env
# and replace the values with your own configurations.
#
# You can also generate this file automatically by running:
# python -m lollms_client.lollms_config_cli_env
# ─────────────────────────────────────────────────────────────────────────────

# === MASTER (PRIMARY) BINDINGS ===
# The master binding is always eagerly instantiated at startup.
LLM_BINDING_NAME=ollama
LLM_MODEL_NAME=llama3.2:3b
LLM_HOST_ADDRESS=http://localhost:11434

TTI_BINDING_NAME=diffusers
TTI_MODEL_NAME=runwayml/stable-diffusion-v1-5

# === UNIVERSAL LAZY PROFILES ===
# Profiles are defined using the format: {PREFIX}_PROFILE_{ALIAS}_{KEY}
# Non-default profiles are NOT instantiated at startup, saving RAM/VRAM.
# They are lazily loaded only when you call `client.switch_model("alias")`.

# ── LLM Profile: Deep Coder ──
# A high-context model for complex coding tasks.
LLM_PROFILE_DEEP_CODER_BINDING_NAME=ollama
LLM_PROFILE_DEEP_CODER_MODEL_NAME=qwen2.5-coder:7b
LLM_PROFILE_DEEP_CODER_HOST_ADDRESS=http://localhost:11434
LLM_PROFILE_DEEP_CODER_FORCED_CONTEXT_SIZE=32768

# ── LLM Profile: Cloud Vision ──
# A cloud-based VLM for high-quality image analysis.
# Uncomment and fill in your key to use.
# LLM_PROFILE_CLOUD_VISION_BINDING_NAME=openai
# LLM_PROFILE_CLOUD_VISION_MODEL_NAME=gpt-4o
# LLM_PROFILE_CLOUD_VISION_SERVICE_KEY=sk-...
# LLM_PROFILE_CLOUD_VISION_VISION_ENABLED=true

# ── TTI Profile: Cloud DALL-E ──
# A cloud-based image generator.
# Uncomment and fill in your key to use.
# TTI_PROFILE_CLOUD_DALLE_BINDING_NAME=openai
# TTI_PROFILE_CLOUD_DALLE_MODEL_NAME=dall-e-3
# TTI_PROFILE_CLOUD_DALLE_SERVICE_KEY=sk-...